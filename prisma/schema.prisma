// Prisma schema — datový model aplikace Coffee Log & Brew Calculator.
// Dokumentace: https://pris.ly/d/prisma-schema
//
// Appka je čistě osobní log bez přihlašování, takže tu nenajdeš žádnou
// tabulku "User" — všechna data patří jedinému člověku, který appku hostuje.
//
// Appka je stavěná primárně na espresso (Flair 58+ 2, mlýnek 1Zpresso
// J-Ultra); filtrová příprava je vedlejší větev s jednodušším záznamem.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Způsob zpracování kávových třešní na sušárně/pražírně.
// "OTHER" pokrývá exotičtější metody (anaerobic, carbonic maceration, ...) —
// konkrétní popis pak patří do volného pole `notes` u zrnka.
enum Process {
  WASHED
  NATURAL
  HONEY
  OTHER
}

// Stupeň pražení. Rozhoduje o tom, který tlakový profil dává smysl
// doporučit — světlá pražení těží z bloomingu a turbo shotů, tmavá
// z klasického kratšího espressa.
enum RoastLevel {
  LIGHT
  MEDIUM_LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK
}

// Rodina metody přípravy. Espresso má tlakové profily a fázový časovač,
// filtr jen poměr a jednoduchý čas.
enum MethodKind {
  ESPRESSO
  FILTER
}

// Profil jedné dávky zrnkové kávy — základní "karta" v deníku.
model Bean {
  id            String     @id @default(cuid())
  roaster       String // pražírna
  coffeeName    String // název kávy tak, jak ji pražírna pojmenovala
  originCountry String
  region        String?
  process       Process
  roastLevel    RoastLevel?
  roastDate     DateTime?

  // Vlastní hodnocení chuti, škála 1–5 (5 = nejvíc). Nepovinné, dokud
  // kávu neochutnáš. Záměrně číselné škály místo volného textu, aby šly
  // později srovnávat a řadit.
  sweetness  Int?
  acidity    Int?
  body       Int?
  aftertaste Int?

  notes    String? // volné poznámky k zrnku
  photoUrl String? // cesta/URL k fotce štítku (bez OCR, jen uložení obrázku)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes Recipe[]

  @@index([roaster])
}

// Metoda přípravy. `defaultRatio` je jmenovatel poměru dávka:výdej,
// např. 2 znamená 1:2 (18 g → 36 g), 16 znamená 1:16 pro filtr.
model BrewMethod {
  id           String     @id @default(cuid())
  name         String     @unique
  kind         MethodKind @default(FILTER)
  defaultRatio Float
  // Výchozí dávka v gramech — u espressa daná velikostí koše (18 g pro
  // IMS Big Bang 18–20 g), u filtru záleží na objemu.
  defaultDoseGrams Float?
  isCustom     Boolean    @default(false)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  recipes  Recipe[]
  profiles PressureProfile[]
}

// Tlakový profil pro pákový kávovar (Flair 58+ 2 má manometr, takže
// tlak jde reálně cílit). Profil je předpis: posloupnost fází, každá
// s cílovým tlakem a délkou. Časovač v appce jimi provede.
model PressureProfile {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  method   BrewMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  methodId String

  // Doporučené výchozí hodnoty, kterými profil předvyplní kalkulačku.
  defaultRatio     Float?
  defaultDoseGrams Float?
  // Doporučený posun mletí oproti tvému běžnému espresso nastavení,
  // v klicích mlýnku (kladné = hrubší). Turbo shot chce výrazně hrubší
  // mletí, blooming zhruba stejné jako klasika.
  grindOffsetClicks Int?
  waterTempC        Float?

  isCustom  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  phases  PressurePhase[]
  recipes Recipe[]
}

// Jedna fáze tlakového profilu, např. "preinfuze 3 bar, 10 s".
model PressurePhase {
  id        String          @id @default(cuid())
  profile   PressureProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  order Int // pořadí fáze v profilu, od 0
  label String // "Preinfuze", "Náběh", "Špička", "Doběh", ...

  // Cílový tlak jako rozsah (na páce se přesná hodnota drží těžko).
  // Blooming má fázi s nulovým tlakem — proto jsou hodnoty nullable.
  targetBarMin Float?
  targetBarMax Float?

  durationSeconds Int
  note            String?

  @@unique([profileId, order])
}

// Konkrétní recept/pokus přípravy daného zrnka danou metodou.
// Jedno zrnko má typicky víc receptů v čase, jak se ladí postup.
model Recipe {
  id     String @id @default(cuid())
  bean   Bean   @relation(fields: [beanId], references: [id], onDelete: Cascade)
  beanId String

  method   BrewMethod @relation(fields: [methodId], references: [id])
  methodId String

  // Použitý tlakový profil (jen u espressa).
  profile   PressureProfile? @relation(fields: [profileId], references: [id])
  profileId String?

  // Dávka mleté kávy a výdej (u espressa vážený nápoj v šálku, u filtru
  // množství vody) — obojí v gramech. `ratio` je jejich podíl, ukládá se
  // odvozeně, aby šlo řadit a porovnávat bez počítání.
  ratio       Float
  doseGrams   Float
  yieldGrams  Float

  // Nastavení mlýnku 1Zpresso J-Ultra ve tvaru X.X.X (otáčky, číslo,
  // klik). Ukládá se po složkách, aby appka uměla spočítat rozdíl mezi
  // dvěma pokusy v klicích a navrhnout konkrétní posun.
  grindRotations Int?
  grindNumber    Int?
  grindClicks    Int?
  // Volný popis mletí — pro jiný mlýnek nebo starší záznamy.
  grindNote      String?

  waterTempC Float?

  bloomSeconds       Int? // délka bloom/preinfuzní fáze
  targetTotalSeconds Int? // plánovaná celková doba extrakce
  actualTotalSeconds Int? // skutečně naměřená doba (z časovače nebo ručně)

  // Záznam vybavení, kterým se to vařilo — snapshot z nastavení v době
  // uložení, aby historie dávala smysl i po výměně mlýnku či kávovaru.
  grinderLabel String?
  brewerLabel  String?

  rating Int? // celkové hodnocení výsledného šálku, škála 1–5
  notes  String?

  brewedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([beanId, brewedAt])
}

// Nastavení appky. Protože jde o osobní log jednoho člověka, je tu vždy
// právě jeden řádek (`id` je natvrdo "singleton") — díky tomu se dá číst
// bez řešení "který záznam je ten můj".
model Settings {
  id String @id @default("singleton")

  grinderName String @default("1Zpresso J-Ultra")
  brewerName  String @default("Flair 58+ 2")
  basketName  String @default("IMS Big Bang 58 mm, 18–20 g (H23,5)")
  screenName  String @default("IMS Big Bang puck screen")

  // Výchozí dávka do koše a běžné espresso nastavení mlýnku, od kterého
  // se odvozují doporučené posuny pro jednotlivé profily.
  defaultDoseGrams   Float @default(18)
  baseGrindRotations Int   @default(0)
  baseGrindNumber    Int   @default(8)
  baseGrindClicks    Int   @default(3)

  updatedAt DateTime @updatedAt
}
