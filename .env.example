# Zkopíruj tento soubor jako `.env` a doplň skutečné hodnoty.
# `.env` se necommituje do gitu (viz .gitignore).

# Lokální vývoj (odpovídá docker-compose.yml):
DATABASE_URL="postgresql://coffee:coffee@localhost:5432/coffee_log?schema=public"

# Produkce (Vercel + Neon): jako environment variables se nastavují přímo
# ve Vercel projektu, ne v .env. Potřeba jsou DVĚ different connection
# stringy z Neon dashboardu:
#   DATABASE_URL — "pooled" connection string, používá appka za běhu
#   DIRECT_URL   — přímá (nepoolovaná) connection string, používá se jen
#                  pro `prisma migrate deploy` při buildu (viz README)
