# Zkopíruj tento soubor jako `.env` a doplň skutečné hodnoty.
# `.env` se necommituje do gitu (viz .gitignore).

# Lokální vývoj (odpovídá docker-compose.yml):
DATABASE_URL="postgresql://coffee:coffee@localhost:5432/coffee_log?schema=public"

# Produkce (Vercel + Neon): jako environment variables se nastavují přímo
# ve Vercel projektu, ne v .env. Potřeba jsou DVĚ různé connection
# stringy z Neon dashboardu:
#   DATABASE_URL — "pooled" connection string, používá appka za běhu
#   DIRECT_URL   — přímá (nepoolovaná) connection string, používá se jen
#                  pro `prisma migrate deploy` při buildu (viz README)

# Přihlašovací PIN appky (4–12 číslic). Zvol si vlastní a nikam ho
# necommituj — proto je tu jen prázdná hodnota. Bez nastaveného PINu
# zůstane appka zamčená. V produkci se nastavuje jako environment
# variable ve Vercel projektu (viz README, sekce Zabezpečení).
APP_PIN=""

# Nepovinné: vlastní tajemství pro podpis přihlašovací cookie (dlouhý
# náhodný řetězec, např. z `openssl rand -base64 32`). Když chybí,
# použije se k tomu DATABASE_URL.
# AUTH_SECRET=""
